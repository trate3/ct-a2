#!/usr/bin/env python3
"""docker -> podman shim for evals/reward_hacking/sandbox.py on a machine that has podman and no docker.

    export PATH="<repo>/evals/tap_live/podman_shim:$PATH"      # then `docker` runs podman
    export CT_RH_SANDBOX=docker                                  # the repo's DockerSandbox (the default)

It execs podman with the same arguments, with three adjustments:
  * an image reference that starts with `aisiuk/` gets the `docker.io/` registry prefix (podman refuses short names
    unless the machine has unqualified-search registries configured);
  * `info --format {{.ServerVersion}}` (used by sandbox.docker_available) becomes `{{.Version.Version}}`;
  * flags named in CT_SHIM_DROP (comma list, e.g. `--cpus,--pids-limit,--memory`) are removed together with their
    value. Use it only if `podman run` refuses a resource limit that the machine's cgroup setup does not delegate to
    rootless users; each dropped limit is then missing from the sandbox (the shim says so on stderr).
CT_SHIM_PODMAN names the podman binary (default `podman`).
"""
import os
import sys

REGISTRY_PREFIX = "docker.io/"
drop = {f.strip() for f in os.environ.get("CT_SHIM_DROP", "").split(",") if f.strip()}
args, out, skip = sys.argv[1:], [], False
for i, a in enumerate(args):
    if skip:
        skip = False
        continue
    flag = a.split("=", 1)[0]
    if flag in drop:
        sys.stderr.write(f"docker shim: dropping {a}\n")
        skip = "=" not in a
        continue
    if a.startswith("aisiuk/"):
        a = REGISTRY_PREFIX + a
    out.append(a.replace("{{.ServerVersion}}", "{{.Version.Version}}"))
podman = os.environ.get("CT_SHIM_PODMAN", "podman")
os.execvp(podman, [podman, *out])
